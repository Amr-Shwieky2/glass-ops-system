# Credentials for the Docker Compose self-hosted stack (docker-compose.yml,
# DEPLOYMENT.md section 1) — a separate, independent Postgres instance from
# local development.
#
# Deliberately a different file from `.env` / `.env.example`: this project's
# local dev server also reads a root-level `.env` file (see `.env.example`,
# which sets `DATABASE_URL` for the native, non-Docker Postgres used in
# development). `docker compose` also looks for a root-level `.env` file by
# default. If the Compose stack used that same file, running the setup below
# in a directory that already has a working dev `.env` would either
# overwrite it or silently pick up unrelated dev-only values. Using a
# distinctly named file, loaded explicitly with `--env-file`, avoids both:
#
#   cp .env.docker.example .env.docker
#   # edit .env.docker with real values, then:
#   docker compose --env-file .env.docker up -d
#
# This file only needs to exist on the host actually running the Compose
# stack — it's unrelated to any `.env` used for local development.

# Passed straight through to the official `postgres` image, which uses them
# to initialize the database on first start. Pick a real password — the
# stack's app container will fail to reach Postgres with the placeholder
# below.
POSTGRES_USER=glass_ops
POSTGRES_PASSWORD=change-me
POSTGRES_DB=glass_ops
