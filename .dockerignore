# Keep the Docker build context (and the runner image) lean. The build
# copies source into the builder stage explicitly; everything below is
# either reproducible inside the image, dev-only tooling, or never needed
# at build/runtime.

# dependencies (reinstalled inside the image from package-lock.json)
node_modules

# build output (regenerated by `next build` inside the image)
.next
out
build

# env files — never bake secrets into an image; compose supplies
# DATABASE_URL etc. as container environment instead
.env
.env.*

# git
.git
.gitignore

# tests, coverage and their reports — not needed to build or run the app
coverage
test-results
playwright-report
tests

# dev-only acceptance/verification scripts (run manually on a host, not
# part of the shipped runtime image)
scripts/*.mjs

# editors / OS cruft
.DS_Store
*.pem
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# docker files themselves don't need to be in the build context twice
Dockerfile
docker-compose.yml
.dockerignore
