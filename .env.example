DATABASE_URL=postgres://user:password@localhost:5432/glass_ops

# Optional: max connections in the server's own Postgres pool
# (src/server/db/client.ts). Defaults to 10 if unset — this app talks to
# one Postgres instance from one Next.js server process, not a fleet of
# serverless functions each opening their own pool, so 10 is plenty for
# most self-hosted installs; raise it only if you see pool-exhaustion
# errors under real concurrent load.
DATABASE_POOL_MAX=10

# Optional: explicit path to a Chromium executable for PDF generation
# (src/server/pdf/render.ts). Leave unset in a normal install — Playwright
# will use its own managed browser after `npx playwright install chromium`.
# Only needed if you want to point at a system-installed Chromium instead
# (e.g. `apt-get install chromium` + CHROMIUM_EXECUTABLE_PATH=/usr/bin/chromium).
CHROMIUM_EXECUTABLE_PATH=

# Optional: only needed for the AI quote-draft feature (src/server/ai/),
# which drafts an itemized quote from a job description as a starting
# point for a human to review in the Quote Builder — it never sends a
# quote itself. This app never installs or manages Ollama; you must
# install and run it yourself: https://ollama.com, then pull the model
# named below (`ollama pull qwen2.5:3b`) before using this feature. If
# Ollama is unreachable, quote drafting fails with a clear error and the
# admin can still build the quote manually — nothing else breaks.
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5:3b

# Optional: how long to wait for Ollama before giving up on a draft
# (src/server/ai/provider.ts). Defaults to 45000ms (45s) if unset — long
# enough for a slow local model on modest hardware, short enough that a
# genuinely unreachable Ollama still fails with a clear error instead of
# spinning indefinitely.
OLLAMA_TIMEOUT_MS=45000

# Optional in local dev: gates POST /api/internal/scheduler (Sprint 4's
# free/self-hosted notification scheduler, src/server/scheduler/). Unset
# means the route refuses every request (fails closed) — only needed if
# you want to trigger a scheduled-reminder sweep locally. In the Docker
# Compose stack this is REQUIRED (see .env.docker.example) and shared with
# the `scheduler` service, which calls this route on an interval.
SCHEDULER_SECRET=
